    ],
    "request": {"method": "POST", "url": "${AUTHCASE_URL}/invoice/publish"},
    "mutating": true,
    "write_verification": {
      "strategy": "changed",
      "environment": "synchronous_isolated",
      "identity": {"id": "reader", "role": "user", "tenant_id": "A", "credential": {"type": "bearer", "value": "${AUTHCASE_READER_TOKEN}"}, "preflight": {"url": "${AUTHCASE_URL}/me", "expected_status": 200, "json_fields": {"id": "reader", "role": "user", "tenant": "A"}}},
      "request": {"method": "GET", "url": "${AUTHCASE_URL}/invoice"},
