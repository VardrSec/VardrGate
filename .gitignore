# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
/dist/
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts.
# coverage.* is anchored to the repository root on purpose: unanchored, it also
# matched internal/coverage/coverage.go and kept that package's only source file
# out of every commit, leaving the published repository unable to build.
*.out
/coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Disposable source exports and binaries for the four-version comparison.
.comparison-work/

# Editor/IDE
# .idea/
# .vscode/

# Agent-local credentials and session state; shared instructions remain tracked.
.claude/settings.local.json
.claude/*.local.json
.claude/.credentials.json
.claude/projects/
.claude/history.jsonl
.codex/auth.json
.codex/config.local.toml
.codex/sessions/
.codex/history.jsonl
.mcp.local.json

# Local working notes and agent instructions are not published artifacts.
AGENTS.md
CLAUDE.md
/.private-notes/
/internal-notes/
/VardrSec-Internal-Notes/

# Private planning, decision records and acceptance receipts stay outside this repository.
/docs/adr/
/docs/evidence/
/docs/*roadmap*
/docs/*handoff*
/docs/*checkpoint*
/docs/*development-notes*
/docs/architecture.md
/docs/authorization-hardening-plan.md
/docs/mvp.md
/docs/research-roadmap-status.md
/benchmarks/roadmap-lab/reports/
/benchmarks/roadmap-lab/competitors/results/

# Generated local comparison records are not public documentation.
/benchmarks/comparison/*.json
/benchmarks/comparison/*.txt

# Unpublished development fragments belong in local notes; public changes go in CHANGELOG.md.
/changelog/nm*.md
/changelog/unreleased*.md
